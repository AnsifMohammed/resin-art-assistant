# Server
PORT=3001
NODE_ENV=development
DEMO_MODE=true
DASHBOARD_URL=https://your-demo-url.replit.app
# Trust X-Forwarded-For from a reverse proxy? Default false (the socket address
# is used as the client IP, e.g. for login rate limiting). Only enable when the
# server sits behind a proxy that overwrites the header. Accepts:
#   true            trust every hop (unsafe unless the proxy strips client XFF)
#   1               trust N hops (integer hop count)
#   10.0.0.0/8,::1  trust only these proxy IPs/CIDRs (also loopback, linklocal, uniquelocal)
TRUST_PROXY=false

# Auth
JWT_SECRET=change_this_to_64_random_chars_minimum
JWT_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Optional: path (relative to backend/) to a CA cert used to verify the
# Postgres server's TLS certificate with full chain + hostname verification.
# For Supabase, download the CA from Project Settings -> Database -> SSL
# Configuration, save it as certs/supabase-ca.crt, and set this to that path.
# Leave unset to use postgres-js's default sslmode=require behaviour
# (encrypted but NOT verified).
DATABASE_CA_CERT=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Meta (leave empty in demo mode)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Owner alerts
OWNER_ALERT_PHONE=
OWNER_WHATSAPP_TOKEN=

# Token encryption
ENCRYPTION_KEY=                    # openssl rand -hex 32

# Demo business
BUSINESS_ID=resin-art-demo-business-01

# Sentry
SENTRY_DSN=                        # from sentry.io

# Upstash Redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Resend email
RESEND_API_KEY=re_...
RESEND_FROM_DOMAIN=yourdomain.com

# Push notifications (VAPID)
VAPID_PUBLIC_KEY=                  # from: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_EMAIL=your@email.com
