# Server
PORT=3001
# Database pool sizes (Supabase session pooler allows 15 clients for the whole project)
DB_POOL_MAX=4
QUEUE_POOL_MAX=2
NODE_ENV=development
DEMO_MODE=true
DASHBOARD_URL=https://your-demo-url.replit.app
# Trust X-Forwarded-For from a reverse proxy? Default false (the socket address
# is used as the client IP, e.g. for login rate limiting). Only enable when the
# server sits behind a proxy that overwrites the header. Accepts:
#   true            trust every hop (unsafe unless the proxy strips client XFF)
#   1               trust N hops (integer hop count)
#   10.0.0.0/8,::1  trust only these proxy IPs/CIDRs (also loopback, linklocal, uniquelocal)
TRUST_PROXY=false

# Auth
JWT_SECRET=change_this_to_64_random_chars_minimum
JWT_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Optional: path (relative to backend/) to a CA cert used to verify the
# Postgres server's TLS certificate with full chain + hostname verification.
# For Supabase, download the CA from Project Settings -> Database -> SSL
# Configuration, save it as certs/supabase-ca.crt, and set this to that path.
# Leave unset to use postgres-js's default sslmode=require behaviour
# (encrypted but NOT verified).
DATABASE_CA_CERT=

# Gemini
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# Meta (leave empty in demo mode)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Instagram (Instagram API with Instagram Login, host graph.instagram.com)
# INSTAGRAM_LIVE=true sends real Instagram DMs even while DEMO_MODE=true
# (WhatsApp keeps following DEMO_MODE). When true, the server refuses to start
# unless INSTAGRAM_ACCESS_TOKEN, INSTAGRAM_ACCOUNT_ID, INSTAGRAM_APP_SECRET and
# META_VERIFY_TOKEN are set.
INSTAGRAM_LIVE=false
# App Dashboard > Instagram > API setup with Instagram login. These are the
# Instagram app's id/secret, which differ from META_APP_ID / META_APP_SECRET.
# INSTAGRAM_APP_SECRET verifies X-Hub-Signature-256 on Instagram webhooks
# (a signature valid under either secret is accepted).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Long-lived (60-day) Instagram User access token. Used to seed the channel:
# the daily refresh job stores refreshed tokens ENCRYPTED in channels.encrypted_token,
# which then takes precedence over this value (to rotate manually, clear that column).
INSTAGRAM_ACCESS_TOKEN=
# The Instagram professional account id (the `user_id` from GET /me?fields=user_id;
# the same id Meta sends as entry[].id in webhooks).
INSTAGRAM_ACCOUNT_ID=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Owner alerts
OWNER_ALERT_PHONE=
OWNER_WHATSAPP_TOKEN=

# Token encryption
ENCRYPTION_KEY=                    # openssl rand -hex 32

# Demo business
BUSINESS_ID=resin-art-demo-business-01

# Sentry
SENTRY_DSN=                        # from sentry.io

# Upstash Redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Resend email
RESEND_API_KEY=re_...
RESEND_FROM_DOMAIN=yourdomain.com

# Push notifications (VAPID)
VAPID_PUBLIC_KEY=                  # from: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_EMAIL=your@email.com

# Broadcasts (WhatsApp template sends to a customer segment)
BROADCAST_MAX_RECIPIENTS=250       # largest audience one broadcast may target
BROADCAST_RATE_PER_SEC=10          # outbound pace while a broadcast is sending
