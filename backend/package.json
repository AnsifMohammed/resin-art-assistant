    "@fastify/jwt": "10.2.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/websocket": "11.3.1",
    "@google/genai": "2.24.0",
    "@neondatabase/serverless": "1.1.0",
    "@sentry/node": "11.0.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "argon2": "0.45.1",
    "dayjs": "1.11.23",
    "dotenv": "18.0.4",
    "drizzle-orm": "0.45.3",
    "drizzle-zod": "0.8.3",
    "fastify": "5.12.5",
    "nanoid": "6.0.1",
    "pg-boss": "12.35.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.9",
    "resend": "6.30.0",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/web-push": "3.6.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
