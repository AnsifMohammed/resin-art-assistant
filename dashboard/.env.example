# dashboard/.env (Vite exposes VITE_* only)

# Sentry DSN for the resin-art-dashboard project (only active in production builds)
VITE_SENTRY_DSN=

# Public VAPID key from: npx web-push generate-vapid-keys (same pair as backend VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=

# API base URL. Optional. Defaults to "/api", which uses the Vite dev proxy to http://localhost:3001.
# Set to a full URL (e.g. http://localhost:3001) only if you want to bypass the proxy.
VITE_API_URL=
